# Copia este fichero como .env.local si prefieres dejar la configuracion de
# Supabase fija en el build en vez de escribirla en Ajustes.
#
# Ojo: en una aplicacion estatica estas dos variables acaban dentro del
# JavaScript publicado. La clave "anon" esta pensada para eso (es publica y
# quien protege los datos es la politica RLS de la base de datos), pero si el
# repositorio es publico y prefieres no ensenar ni la URL, dejalo vacio y
# escribelo en Ajustes → Sincronizacion, que se guarda solo en tu dispositivo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
